# AI tutor (server-side only). Copy to .env.local for `npm run dev`, or set these
# as environment variables on your host (e.g. Vercel → Project → Settings → Environment Variables).
# Never prefix them with VITE_, which would bundle them into the browser code.

# Required for OpenAI (or any hosted OpenAI-compatible API).
AI_API_KEY=
# Optional. Any OpenAI-compatible Chat Completions endpoint. Default: https://api.openai.com/v1
# Local open-source model with Ollama: AI_BASE_URL=http://localhost:11434/v1 (no key needed)
AI_BASE_URL=
# Optional. Default: gpt-4o-mini
AI_MODEL=
# Optional. Reply length cap; 450 is also the ceiling (higher values are ignored).
AI_MAX_TOKENS=450
# Optional rate limits per client IP (defaults shown). The browser also caps 30 messages per device per day.
# A classroom often shares one IP, so schools may want to raise these.
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=30

# Rate-limit storage. With Redis, limits are shared by every server instance and survive restarts and
# cold starts. Use an Upstash Redis database (Vercel → Storage → Upstash, which sets these for you;
# the older KV_REST_API_URL / KV_REST_API_TOKEN names also work). Without Redis, `npm run dev` / `preview`
# keep the counts in server/data/tutor-rate-limit.json, and a Vercel Function keeps them in memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional secret mixed into the hashed IP keys stored in Redis (raw IPs are never stored).
AI_RATE_LIMIT_SALT=
# Extra browser origins allowed to call /api/tutor (comma-separated). The site's own origin is always allowed.
TUTOR_ALLOWED_ORIGINS=

# Accounts API (server/index.ts). See docs/SECURITY.md.
# 32+ random characters; required in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Exact origins of the web app when it calls the API from another origin. No "*".
CORS_ORIGINS=
# 1 in production (default there): HTTPS-only __Host- cookie.
COOKIE_SECURE=
# Lax (default), Strict, or None when the app and the API are on different sites.
COOKIE_SAMESITE=
# 1 behind your own reverse proxy, so rate limits see the real client address.
TRUST_PROXY=

# Accounts API database (server/). PostgreSQL 13+ or Supabase. Set DATABASE_URL, or the DB_* values.
# Supabase: Project Settings → Database → Connection string (Session pooler URI); append ?sslmode=require.
# Then run `npm run migrate` once (and again after upgrades). Without either, `npm run api` uses a JSON file.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=edulab
# "true" to require TLS when using DB_* (DATABASE_URL uses ?sslmode=require instead)
DB_SSL=

# Error monitoring (see README → Monitoring).
# Server-side: Slack or Discord incoming-webhook URL that gets the first occurrence of each client error per hour. Optional.
MONITORING_WEBHOOK_URL=
# Server-side: max error reports accepted per client IP per minute (default 30).
MONITORING_RATE_LIMIT=
# Client build: where the browser sends error reports (default /api/errors). Set to `off` to disable.
VITE_MONITORING_URL=
# Client build: fraction of errors reported, 0..1 (default 1).
VITE_MONITORING_SAMPLE_RATE=
